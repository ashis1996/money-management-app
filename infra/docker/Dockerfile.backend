# =====================================================================
# Money Management — Backend API image (NestJS, npm workspaces)
#
# Build context MUST be the repo root so we can install workspace
# dependencies properly. The repo's package.json declares workspaces
# for `backend` and `shared`; we build both and run `dist/main.js`
# from the backend workspace.
# =====================================================================

# ---------- Build stage ----------
FROM node:20-alpine AS builder

WORKDIR /repo

# Copy workspace manifests first for better layer caching.
COPY package.json package-lock.json ./
COPY backend/package.json ./backend/
COPY shared/package.json ./shared/

# Install only the workspaces we need for the backend image.
# `--include-workspace-root` ensures dev tools (typescript, tsc-alias,
# concurrently) are installed at the repo root so npm scripts resolve.
# `--ignore-scripts` skips Prisma's postinstall — we run it explicitly
# after copying source so the schema is available.
RUN npm install --no-audit --no-fund --ignore-scripts \
    --workspace=backend \
    --workspace=shared \
    --include-workspace-root

# Copy source code for the workspaces we need.
COPY shared ./shared
COPY backend ./backend

# Generate the Prisma client (needs schema.prisma to be present).
RUN npx --workspace=backend prisma generate

# Build shared first so the backend can import its compiled output.
RUN npm run build --workspace=shared
RUN npm run build --workspace=backend


# ---------- Production stage ----------
FROM node:20-alpine AS production

WORKDIR /repo

ENV NODE_ENV=production

# `wget` is used by the docker-compose healthcheck.
RUN apk add --no-cache wget

# Copy installed node_modules and built artifacts from the builder.
# We deliberately copy node_modules instead of running another `npm
# install --omit=dev` because:
#   1. We need the `prisma` CLI at runtime for `prisma migrate deploy`,
#      and it's a devDependency of the backend workspace.
#   2. Re-installing requires network access on every image build.
# The trade-off is a slightly larger image; acceptable for an MVP.
COPY --from=builder /repo/node_modules ./node_modules
COPY --from=builder /repo/backend/node_modules ./backend/node_modules
COPY --from=builder /repo/shared/node_modules ./shared/node_modules
COPY --from=builder /repo/backend/dist ./backend/dist
COPY --from=builder /repo/backend/prisma ./backend/prisma
COPY --from=builder /repo/backend/package.json ./backend/package.json
COPY --from=builder /repo/shared/dist ./shared/dist
COPY --from=builder /repo/shared/package.json ./shared/package.json
COPY --from=builder /repo/package.json ./package.json
COPY --from=builder /repo/package-lock.json ./package-lock.json

# Drop privileges.
RUN addgroup -g 1001 -S nodejs && \
    adduser -S nodejs -u 1001 && \
    chown -R nodejs:nodejs /repo
USER nodejs

WORKDIR /repo/backend

EXPOSE 3000

# Healthcheck hits the live HTTP endpoint added by HealthController.
HEALTHCHECK --interval=15s --timeout=5s --start-period=60s --retries=10 \
  CMD wget -q -O- http://localhost:3000/api/v1/health >/dev/null 2>&1 || exit 1

# Run migrations on startup, then launch the API. `prisma migrate deploy`
# is idempotent — safe to run on every container start.
CMD ["sh", "-c", "npx prisma migrate deploy && node dist/src/main.js"]
