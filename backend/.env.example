# ============================================
# BACKEND ENVIRONMENT VARIABLES
# ============================================
# This file documents the variables the NestJS backend reads.
#
# The repo root also has a .env.example that covers the full stack
# (backend + AI service + mobile). Keep this file in sync with the
# backend-relevant entries there. When in doubt, the root file is the
# canonical reference.
#
# Copy to .env and fill in:
#   cp backend/.env.example backend/.env

# --------------------------------------------
# Application Settings
# --------------------------------------------
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1

# --------------------------------------------
# Database (PostgreSQL)
# --------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/money_management?schema=public

# --------------------------------------------
# Redis
# --------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --------------------------------------------
# RabbitMQ
# --------------------------------------------
RABBITMQ_URL=amqp://guest:guest@localhost:5672
# One queue per event type so a slow consumer can't block unrelated work
# (see backend/src/config/rabbitmq.module.ts).
RABBITMQ_TRANSACTION_QUEUE=transaction.events
RABBITMQ_SUBSCRIPTION_QUEUE=subscription.events
RABBITMQ_NOTIFICATION_QUEUE=notification.events

# --------------------------------------------
# JWT Authentication
# --------------------------------------------
# REQUIRED. Both secrets must be at least 32 characters and must not be a
# known placeholder (the app refuses to boot otherwise — see
# config/secret-validation.ts). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=
REFRESH_TOKEN_EXPIRES_IN=7d

# --------------------------------------------
# Bcrypt
# --------------------------------------------
BCRYPT_ROUNDS=10

# --------------------------------------------
# SMS retention
# --------------------------------------------
# Days to keep raw SMS body + parsedData in SmsLog before scrubbing.
# Set to 0 to disable the retention cron entirely. Higher values are
# allowed for jurisdictions with longer retention requirements.
SMS_RETENTION_DAYS=90

# --------------------------------------------
# AI Service
# --------------------------------------------
# Must include the /api/v1 prefix — AiProxyService appends paths like
# /sms/parse and /behavior/tag-transactions directly to this base URL.
AI_SERVICE_URL=http://localhost:8000/api/v1
# Optional toggle to disable the AI parser fallback (regex still works):
# SMS_USE_AI_PARSER=false
AI_TIMEOUT_MS=30000
# Shared secret used to authenticate as the trusted backend when calling
# the AI service. Required in production. The AI service must be started
# with the same value as INTERNAL_API_TOKEN.
INTERNAL_API_TOKEN=

# --------------------------------------------
# LLM API Keys (Optional)
# --------------------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --------------------------------------------
# Push Notifications (Firebase)
# --------------------------------------------
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --------------------------------------------
# Rate Limiting
# --------------------------------------------
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# --------------------------------------------
# Logging
# --------------------------------------------
# pino's level hierarchy: trace | debug | info | warn | error | fatal | silent.
# 'info' is the production default. 'debug' surfaces every health-probe ping.
LOG_LEVEL=debug

# --------------------------------------------
# CORS
# --------------------------------------------
# Comma-separated list of allowed origins. In production you must set this;
# otherwise CORS is disabled (browsers will block cross-origin requests).
# In development the app falls back to localhost defaults.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081
