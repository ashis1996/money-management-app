# Application
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/money_management?schema=public

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_SMS_QUEUE=sms.processing
RABBITMQ_TRANSACTION_QUEUE=transaction.analysis
RABBITMQ_NOTIFICATION_QUEUE=notifications

# JWT
# REQUIRED: Both secrets must be at least 32 characters and must not match
# any placeholder value (the app will refuse to start otherwise).
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=
REFRESH_TOKEN_EXPIRES_IN=7d

# Bcrypt
BCRYPT_ROUNDS=10

# AI Service
# Must include /api/v1 — AiProxyService appends paths like /sms/parse directly.
AI_SERVICE_URL=http://localhost:8000/api/v1
AI_TIMEOUT_MS=30000
# Shared secret used to authenticate as the trusted backend when calling the
# AI service. Must match the AI service's INTERNAL_API_TOKEN. Required in
# production; optional locally (the AI service warns and accepts traffic).
INTERNAL_API_TOKEN=

# Push Notifications (Firebase)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=your-client-email
FIREBASE_PRIVATE_KEY=your-private-key

# Rate Limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# Logging
LOG_LEVEL=debug

# CORS — comma-separated list of allowed origins. In production you must
# set this; otherwise CORS is disabled (browsers will block cross-origin
# requests). In development the app falls back to localhost defaults.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081
