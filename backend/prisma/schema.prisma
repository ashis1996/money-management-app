// ============================================================
// NEW MODELS - Advanced Features
// ============================================================

/// Goal: User savings goals
model Goal {
  id              String    @id @default(uuid())
  userId          String
  name            String
  targetAmount    Decimal   @db.Decimal(15, 2)
  currentAmount   Decimal   @default(0) @db.Decimal(15, 2)
  currency        String    @default("INR")
  targetDate      DateTime?
  category        String?   // TRIP, GADGET, EMERGENCY_FUND, etc.
  icon            String?
  color           String?
  autoAllocate    Boolean   @default(false)
  allocationPercent Decimal? @db.Decimal(5, 4) // % of income to auto-allocate
  priority        Int       @default(0) // 1 = highest
  isCompleted     Boolean   @default(false)
  completedAt     DateTime?
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isCompleted])
  @@index([targetDate])
  @@index([deletedAt])
}

/// ActionCard: Personalized action items for users
model ActionCard {
  id              String    @id @default(uuid())
  userId          String
  type            String    // CANCEL_SUBSCRIPTION, REDUCE_SPENDING, SET_BUDGET, etc.
  title           String
  description     String
  priority        String    @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  impactAmount    Decimal?  @db.Decimal(15, 2) // Potential savings/impact
  impactType      String?   // SAVINGS, HEALTH_SCORE, GOAL_PROGRESS
  status          String    @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED, DISMISSED
  actionData      Json      @default("{}") // Action-specific data
  expiresAt       DateTime?
  completedAt     DateTime?
  dismissedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, status])
  @@index([type])
  @@index([priority])
  @@index([expiresAt])
}

/// WeeklySummary: Personalized weekly money summaries
model WeeklySummary {
  id              String    @id @default(uuid())
  userId          String
  weekStartDate   DateTime
  weekEndDate     DateTime
  
  // Summary Stats
  totalSpent      Decimal   @db.Decimal(15, 2)
  totalIncome     Decimal   @db.Decimal(15, 2)
  savingsAmount   Decimal   @db.Decimal(15, 2)
  savingsRate     Decimal   @db.Decimal(5, 4)
  
  // Insights
  topCategories   Json      @default("[]")
  topMerchants    Json      @default("[]")
  unusualSpending Json?     // Any unusual patterns
  behaviorInsights Json?    // Behavioral insights
  
  // AI Generated
  aiSummary       String?   // Natural language summary
  recommendations Json      @default("[]")
  
  createdAt       DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, weekStartDate])
  @@index([userId])
  @@index([weekStartDate])
}

/// BehavioralPattern: User spending behavior patterns
model BehavioralPattern {
  id              String    @id @default(uuid())
  userId          String
  
  // Time-based patterns
  lateNightSpending Decimal @default(0) @db.Decimal(15, 2)
  weekendSpending   Decimal @default(0) @db.Decimal(15, 2)
  impulseSpending   Decimal @default(0) @db.Decimal(15, 2)
  
  // Category preferences
  dominantCategories Json   @default("[]")
  
  // Spending triggers
  emotionalTriggers Json    @default("[]") // Stress, celebration, etc.
  
  // Pattern scores
  consistencyScore Decimal  @default(0) @db.Decimal(5, 4) // How consistent is spending
  predictabilityScore Decimal @default(0) @db.Decimal(5, 4)
  
  // Time period
  periodStart     DateTime
  periodEnd       DateTime
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([userId, periodStart])
  @@index([userId])
}


/// DeviceToken: Push notification tokens (Expo Push / FCM)
model DeviceToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  platform  String   // 'ios' | 'android' | 'web'
  deviceId  String?  // Stable device identifier (best-effort)
  appVersion String?
  isActive  Boolean  @default(true)
  lastUsedAt DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isActive])
  @@index([token])
}
