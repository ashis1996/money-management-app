# Web App Environment
#
# All public env vars MUST be prefixed with NEXT_PUBLIC_. Anything else
# is server-only and never shipped to the browser.

# Backend URL the Next.js server (route handlers, server components)
# uses to reach the NestJS API. Server-only — the browser never hits
# this URL directly; client requests go through /api/proxy/*.
INTERNAL_API_URL=http://localhost:3000/api/v1

# Optional: marketing display name + version (safe to ship to browser).
NEXT_PUBLIC_APP_NAME=MoneyMind
NEXT_PUBLIC_APP_VERSION=1.0.0
