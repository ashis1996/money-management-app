# Mobile App Environment Variables
#
# The API base URL is resolved in this order:
#   1. EXPO_PUBLIC_API_URL (this file)
#   2. expoConfig.extra.apiUrl in app.json
#   3. http://10.0.2.2:3000/api/v1 (Android emulator default)
#
# Picking the right value for your setup:
#   * Android emulator         -> http://10.0.2.2:3000/api/v1
#   * iOS simulator            -> http://localhost:3000/api/v1
#   * Physical device on Wi-Fi -> http://<your-LAN-ip>:3000/api/v1
#   * Production               -> https://api.your-domain.com/api/v1

EXPO_PUBLIC_API_URL=http://10.0.2.2:3000/api/v1

# App Configuration (optional - read from app.json by default)
EXPO_PUBLIC_APP_NAME=MoneyMind
EXPO_PUBLIC_APP_VERSION=1.0.0

# Push notifications:
#   Expo push tokens work out of the box for managed workflow apps.
#   FCM (google-services.json) is only required for bare workflow or
#   when sending notifications through your own FCM app credentials.
