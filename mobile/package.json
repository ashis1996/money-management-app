{
  "name": "@money-management/mobile",
  "version": "1.0.0",
  "private": true,
  "main": "index.js",
  "_dependency_notes": "expo-router was previously declared as the entry but never used; the app builds its navigation manually with @react-navigation. Reverted `main` to the standard index.js entry point. expo-sms (one-shot SMS sending) is dropped — we use react-native-android-sms-listener for incoming-SMS auto-capture, never outbound. Redux and redux-persist were transitively pulled in but no source file imports them; Zustand is the actual state library.",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo/vector-icons": "^14.0.0",
    "@react-navigation/bottom-tabs": "^7.16.2",
    "@react-navigation/native": "^6.1.9",
    "@react-navigation/stack": "^6.3.20",
    "@react-native-async-storage/async-storage": "1.21.0",
    "@tanstack/react-query": "^5.17.0",
    "axios": "^1.6.5",
    "expo": "~50.0.0",
    "expo-constants": "~15.4.5",
    "expo-device": "~5.9.3",
    "expo-font": "~11.10.2",
    "expo-linking": "~6.2.2",
    "expo-notifications": "~0.27.6",
    "expo-secure-store": "~12.8.1",
    "expo-status-bar": "~1.11.1",
    "expo-system-ui": "~2.9.3",
    "react": "18.2.0",
    "react-native": "0.73.2",
    "react-native-gesture-handler": "~2.14.0",
    "react-native-reanimated": "~3.6.1",
    "react-native-safe-area-context": "4.8.2",
    "react-native-screens": "~3.29.0",
    "react-native-svg": "14.1.0",
    "zod": "^3.22.4",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@babel/core": "^7.23.6",
    "@types/react": "~18.2.45",
    "@typescript-eslint/eslint-plugin": "^6.16.0",
    "@typescript-eslint/parser": "^6.16.0",
    "eslint": "^8.56.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "jest": "^29.7.0",
    "typescript": "^5.3.3"
  },
  "jest": {
    "preset": "jest-expo",
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg)"
    ]
  }
}
