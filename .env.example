# ============================================
# MONEY MANAGEMENT APP - ENVIRONMENT VARIABLES
# ============================================
# This is the CANONICAL reference for every env var the system reads,
# across backend, AI service, and mobile.
#
# Workspace-specific copies:
#   - backend/.env.example      backend-only subset
#   - ai-service/.env.example   AI service subset (none yet)
#
# Workspace files exist so each app's `cp .env.example .env` flow
# stays one-step. Keep this file the canonical source of truth — when
# you add a new env var, add it here first, then mirror only what's
# relevant to the workspace file.
#
# Copy to .env at the repo root for `docker-compose up`, or per-
# workspace for local `npm run dev`.

# --------------------------------------------
# Application Settings
# --------------------------------------------
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1

# --------------------------------------------
# Database (PostgreSQL)
# --------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/money_management?schema=public

# --------------------------------------------
# Redis
# --------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --------------------------------------------
# RabbitMQ
# --------------------------------------------
RABBITMQ_URL=amqp://guest:guest@localhost:5672
# One queue per event type so a slow consumer can't block unrelated work
# (see backend/src/config/rabbitmq.module.ts).
RABBITMQ_TRANSACTION_QUEUE=transaction.events
RABBITMQ_SUBSCRIPTION_QUEUE=subscription.events
RABBITMQ_NOTIFICATION_QUEUE=notification.events

# --------------------------------------------
# JWT Authentication
# --------------------------------------------
# REQUIRED. Both must be at least 32 characters and must not be one of the
# placeholder values rejected at startup. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=
REFRESH_TOKEN_EXPIRES_IN=7d

# --------------------------------------------
# Bcrypt
# --------------------------------------------
BCRYPT_ROUNDS=10

# --------------------------------------------
# SMS retention
# --------------------------------------------
# Days to keep raw SMS body + parsedData in SmsLog before scrubbing.
# Set to 0 to disable the retention cron entirely. Higher values are
# allowed for jurisdictions with longer retention requirements.
SMS_RETENTION_DAYS=90

# --------------------------------------------
# AI Service
# --------------------------------------------
# Must include the /api/v1 prefix — the AiProxyService appends paths like
# /sms/parse and /behavior/tag-transactions directly to this base URL.
AI_SERVICE_URL=http://localhost:8000/api/v1
# Optional toggle to disable the AI parser fallback (regex still works):
# SMS_USE_AI_PARSER=false
AI_TIMEOUT_MS=30000
# Shared secret used to authenticate as the trusted backend when calling
# the AI service. Required in production. The AI service must be started
# with the same value as INTERNAL_API_TOKEN.
INTERNAL_API_TOKEN=

# --------------------------------------------
# LLM API Keys (Optional)
# --------------------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --------------------------------------------
# Push Notifications (Firebase)
# --------------------------------------------
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --------------------------------------------
# Rate Limiting
# --------------------------------------------
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# --------------------------------------------
# Logging
# --------------------------------------------
LOG_LEVEL=debug

# --------------------------------------------
# CORS (Comma-separated origins)
# --------------------------------------------
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081

# --------------------------------------------
# Mobile App (Expo)
# --------------------------------------------
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000/api/v1
