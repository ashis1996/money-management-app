# ============================================
# MONEY MANAGEMENT APP - ENVIRONMENT VARIABLES
# ============================================
# Copy this file to .env and fill in your values

# --------------------------------------------
# Application Settings
# --------------------------------------------
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1

# --------------------------------------------
# Database (PostgreSQL)
# --------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/money_management?schema=public

# --------------------------------------------
# Redis
# --------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --------------------------------------------
# RabbitMQ
# --------------------------------------------
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_SMS_QUEUE=sms.processing
RABBITMQ_TRANSACTION_QUEUE=transaction.analysis
RABBITMQ_NOTIFICATION_QUEUE=notifications

# --------------------------------------------
# JWT Authentication
# --------------------------------------------
# IMPORTANT: Change these in production!
JWT_SECRET=your-super-secret-jwt-key-minimum-32-chars
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=your-refresh-token-secret-minimum-32-chars
REFRESH_TOKEN_EXPIRES_IN=7d

# --------------------------------------------
# Bcrypt
# --------------------------------------------
BCRYPT_ROUNDS=10

# --------------------------------------------
# AI Service
# --------------------------------------------
AI_SERVICE_URL=http://localhost:8000

# --------------------------------------------
# LLM API Keys (Optional)
# --------------------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --------------------------------------------
# Push Notifications (Firebase)
# --------------------------------------------
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --------------------------------------------
# Rate Limiting
# --------------------------------------------
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# --------------------------------------------
# Logging
# --------------------------------------------
LOG_LEVEL=debug

# --------------------------------------------
# CORS (Comma-separated origins)
# --------------------------------------------
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081

# --------------------------------------------
# Mobile App (Expo)
# --------------------------------------------
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000/api/v1
